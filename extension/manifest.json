{
  "manifest_version": 3,
  "name": "Evelyn Dream Lens",
  "version": "0.1.0",
  "description": "Let Evelyn see deeper into your dreams.",
  "permissions": [
    "history",
    "topSites",
    "tabs",
    "bookmarks",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "https://evelyn.app/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
